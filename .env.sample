# 앱 설정은 .env와 config.json 두 파일로 병렬 관리된다.
#
# .env   — 인스턴스마다 달라지는 값
#          다중화 환경에서 각 앱에 개별 값이 필요한 경우 이 파일에 추가한다.
#          (예: 앱 리스닝 포트, 인스턴스 식별 정보 등)
#
# config.json — 모든 인스턴스가 공유하는 값
#               민감 정보(DB 접속 정보 등)나 다중화 환경에서 앱 전체가
#               동일한 값을 사용하는 경우 이 파일에 추가한다.
#               프로덕션에서는 GCP Secret Manager를 통해 주입된다.

# 앱이 리스닝할 포트 번호
PORT=4000

# 현재 인스턴스의 사설 IP 주소 (프로덕션 환경용)
# PRIVATE_IP=